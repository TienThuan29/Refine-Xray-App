# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY

# DynamoDB Configuration
DYNAMODB_TABLE_PREFIX=RefineXrayApp
USER_TABLE=UserTable
REPORT_TEMPLATE_TABLE=ReportTemplateTable
PATIENT_PROFILE_TABLE=PatientProfileTable
FOLDER_TABLE=FolderTable
CHAT_SESSION_TABLE=ChatSessionTable
REPORT_TABLE=ReportTable
SYSTEM_VAR_TABLE=SystemVarTable

# S3 Configuration
S3_BUCKET_NAME=refine-xray-app-bucket

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_ACCESS_TOKEN_EXPIRATION=15
JWT_REFRESH_TOKEN_EXPIRATION=7
BCRYPT_SALT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# System Configuration
SYSTEM_SECRET=your-system-secret-key
HASHING_SECRET_KEY=your-hashing-secret-key
